  "bugs": {
    "url": "https://github.com/LEmma3/Automation-Tools/issues"
  },
  "homepage": "https://github.com/LEmma3/Automation-Tools#readme",
  "dependencies": {
    "modules": "^0.4.0",
    "node": "^26.5.1"
  },
  "devDependencies": {
    "cypress": "^15.19.0",
    "cypress-multi-reporters": "^2.0.5",
    "mochawesome": "^8.0.0",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "npm-run-all2": "^8.0.4",
    "rimraf": "^6.1.3"
  }
}
